# platform-specific SDKs (install per platform: OpenCV / onnxruntime / ncnn)
# NOTE: anchored to root so cpp/third_party/CLI11.hpp (needed to build) is kept
/third_party/
# build + runtime outputs
cpp/build*/
gui/build*/
gui/dist/
gui/dist-cuda/
runs_edge/
preds_*/
results/
visdrone50/
__pycache__/
*.pyc
# quantization intermediates + deferred INT8 experiments
models/*.prep.onnx
models/esmoe_n_visdrone.onnx
models/*int8*.onnx
# INT8 calibration data (regenerated locally from val images, not tracked)
calib/
calib_mnn/
# stray training run dirs
v0.1-N-*/

# release bundles (distribute via GitHub Releases, not git)
dist/

# local-only build log (not published)
PROGRESS.md

# internal dev helpers / release ops (local-only)
scripts/_*
scripts/make_release.sh

# model binaries -> shipped as GitHub Release assets, not tracked
models/

# Mac/Swift build artifacts
mac/.build/
mac/*.mlpackage
mac/*.mlmodelc
# local SDK paths (per-machine, not shared)
gui/sdk-paths.cmd
tests/ncnn_rawdump

# private working docs + mid-build artifacts (local-only, never publish)
PROJECT.md
PROJECT03_FEASIBILITY.md
runs/

# standalone ncnn bench build trees (cpp/tools/CMakeLists.txt)
cpp/tools/build*/

# never commit local data/SDK dirs (or symlinks named like them)
/models
/third_party
/visdrone50

# local eval sets (release assets, see scripts/package_eval_sets.sh)
/datasets

# generated by deploy/docker/stage_bundle.sh
deploy/docker/version.bzl
deploy/docker/MODULE.bazel.lock
deploy/docker/bazel-*
deploy/docker/stage/
deploy/docker/*.tar
